# Express 백엔드 주소 (API는 이 주소 + /api 로 호출)
NEXT_PUBLIC_API_URL=http://localhost:4000
# enabled: MSW 가짜 API 사용 / disabled: 실제 백엔드 호출
NEXT_PUBLIC_API_MOCKING=enabled

# 토스페이먼츠 (개발자센터 > API 키 > "API 개별 연동 키". 결제위젯 키 gck/gsk 아님)
# 클라이언트 키가 비어 있으면 장바구니가 테스트 결제창(가짜)을 띄운다
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 시크릿 키는 서버 전용. 백엔드 없이 MSW로 쓸 때만 Next 라우트(/api/toss/*)가 사용. 절대 커밋하지 말 것
TOSS_SECRET_KEY=
